<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.nea</groupId>
    <artifactId>NeaBansProxy</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>NeaBansProxy</name>
    <description>Plugin de proxy para NeaBans - bloqueo de bans a nivel de red</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Nombre por defecto; los perfiles lo sobreescriben -->
        <proxy.finalName>NeaBansProxy</proxy.finalName>
    </properties>

    <!-- ===================================================================== -->
    <!-- Repositorios                                                           -->
    <!-- ===================================================================== -->
    <repositories>
        <!-- PaperMC — Waterfall (fork BungeeCord) + Velocity -->
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <!-- ===================================================================== -->
    <!-- Dependencias                                                           -->
    <!-- ===================================================================== -->
    <dependencies>

        <!-- ── Waterfall API (fork oficial de BungeeCord por PaperMC, 100% compatible) -->
        <!-- ── Misma API que BungeeCord — funciona en BungeeCord, Waterfall y Travertine -->
        <dependency>
            <groupId>io.github.waterfallmc</groupId>
            <artifactId>waterfall-api</artifactId>
            <version>1.21-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- ── Velocity API (provided por el proxy Velocity) -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>3.2.0-SNAPSHOT</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- ── HikariCP: pool de conexiones (compile → shadeado) ─────────── -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- ── MySQL Connector/J 8 (compile → shadeado) ──────────────────── -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- ── SLF4J Simple: binding requerido por HikariCP (shadeado) ───── -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.12</version>
            <scope>compile</scope>
        </dependency>

        <!-- ── SnakeYAML: lectura de config.yml (shadeado) ───────────────── -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================================== -->
    <!-- Build                                                                  -->
    <!-- ===================================================================== -->
    <build>
        <finalName>${proxy.finalName}</finalName>
        <defaultGoal>clean package</defaultGoal>

        <plugins>

            <!-- ── Compilador Java 21 ─────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- ── Maven Shade: fat-JAR con relocaciones ─────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Relocaciones: todas bajo me.nea.neabansproxy.libs.* para
                                 evitar conflictos con el plugin de Paper y otros plugins -->
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>me.nea.neabansproxy.libs.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.mysql</pattern>
                                    <shadedPattern>me.nea.neabansproxy.libs.mysql</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>me.nea.neabansproxy.libs.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>me.nea.neabansproxy.libs.snakeyaml</shadedPattern>
                                </relocation>
                            </relocations>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <transformers>
                                <!-- Merge de archivos SPI (ServiceLoader) del driver MySQL y HikariCP -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
                            </transformers>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- ===================================================================== -->
    <!-- Perfiles: mvn package -P bungee  →  NeaBansProxy-bungee.jar          -->
    <!--           mvn package -P velocity →  NeaBansProxy-velocity.jar        -->
    <!-- ===================================================================== -->
    <profiles>

        <profile>
            <id>bungee</id>
            <properties>
                <proxy.finalName>NeaBansProxy-bungee</proxy.finalName>
            </properties>
        </profile>

        <profile>
            <id>velocity</id>
            <properties>
                <proxy.finalName>NeaBansProxy-velocity</proxy.finalName>
            </properties>
        </profile>

    </profiles>

</project>
